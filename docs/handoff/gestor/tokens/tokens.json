{
  "$schema": "https://design-tokens.org/schema.json",
  "brand": {
    "primary":       { "light": "#B81414", "dark": "#B81414" },
    "strong":        { "light": "#660000", "dark": "#8F1414" },
    "onDark":        { "light": null,      "dark": "#F0817D" },
    "surface":       { "light": "#FCE3E3", "dark": "#2C1517" },
    "surfaceSoft":   { "light": "#FFF7F7", "dark": "#221417" },
    "border":        { "light": "#F3C9C9", "dark": "#5A2426" }
  },
  "surface": {
    "app":  { "light": "#EDEEF0", "dark": "#0B0C0D" },
    "s1":   { "light": "#FFFFFF", "dark": "#17191A" },
    "s2":   { "light": "#F9FAFB", "dark": "#1E2223" },
    "s3":   { "light": "#F4F5F6", "dark": "#23282A" }
  },
  "border": {
    "strong": { "light": "#E9EBED", "dark": "#282C2D" },
    "subtle": { "light": "#F1F2F4", "dark": "#1F2323" },
    "input":  { "light": "#C3C6C6", "dark": "#535959" }
  },
  "text": {
    "primary":   { "light": "#111212", "dark": "#ECEFEF" },
    "secondary": { "light": "#414141", "dark": "#B4B9B9" },
    "tertiary":  { "light": "#899090", "dark": "#929999" }
  },
  "feedback": {
    "success": { "main": { "light": "#149142", "dark": "#33BB6A" }, "on": { "light": "#0C5728", "dark": "#63D08D" }, "surface": { "light": "#E7F4EC", "dark": "#123326" } },
    "warning": { "main": { "light": "#D38808", "dark": "#E7A63F" }, "on": { "light": "#7F5205", "dark": "#E6A94F" }, "surface": { "light": "#FBF3E6", "dark": "#332811" } },
    "danger":  { "main": { "light": "#C61D1D", "dark": "#EE4E4A" }, "on": { "light": "#771111", "dark": "#F2857F" }, "surface": { "light": "#F9E8E8", "dark": "#331719" } },
    "info":    { "main": { "light": "#0374AE", "dark": "#40A9E0" }, "on": { "light": "#024668", "dark": "#6FBBE3" }, "surface": { "light": "#E6F1F7", "dark": "#0F2A3A" } }
  },
  "series": {
    "clinicaMedica":  { "light": "#111212", "dark": "#E6E9E9" },
    "cirurgia":       { "light": "#0374AE", "dark": "#40A9E0" },
    "ginecoObst":     { "light": "#11A694", "dark": "#2ED4BC" },
    "preventiva":     { "light": "#6632DC", "dark": "#AC8FF6" },
    "pediatria":      { "light": "#D38808", "dark": "#E7A63F" }
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "pill": "10em" },
  "space":  { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px" },
  "type": {
    "fontSans": "Inter, system-ui, sans-serif",
    "fontMono": "'Roboto Mono', ui-monospace, monospace",
    "scale": {
      "screenTitle":  { "size": 28, "line": 32, "weight": 700, "tracking": "-0.01em" },
      "sectionTitle": { "size": 15, "line": 22, "weight": 700 },
      "body":         { "size": 13, "line": 20, "weight": 400 },
      "bodySmall":    { "size": 12, "line": 18, "weight": 400 },
      "caption":      { "size": 11, "line": 16, "weight": 500 },
      "overline":     { "size": 10, "line": 14, "weight": 700, "tracking": "0.06em", "transform": "uppercase" },
      "heroNumber":   { "size": 40, "line": 34, "weight": 800, "tracking": "-0.03em" },
      "cardNumber":   { "size": 20, "line": 26, "weight": 700 }
    }
  },
  "motion": {
    "duration": { "1": "80ms", "2": "140ms", "3": "200ms", "4": "320ms", "5": "560ms" },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter":    "cubic-bezier(0, 0, 0, 1)",
      "exit":     "cubic-bezier(0.4, 0, 1, 1)"
    }
  }
}
