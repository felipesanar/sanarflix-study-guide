{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Mentoria do Flix · operações usadas pelo Academy",
    "version": "2.3.0-proposta",
    "description": "PROPOSTA para revisão (11/11/2026), derivada de docs/mentoria/05-solucao-revisada.md. Cobre as operações que a Página do Mentor (Academy) chama pelo proxy, mais as duas operações do mentorado que mudam o que o mentor vê (reservar e cancelar reserva). Cadastro, alocação e GET /mentorado/mentoria ficam fora deste documento. Nomes em português como no contrato v2.2; o back-end do Flix vai padronizar em inglês. Convenções: JSON camelCase, IDs uuid, datas ISO 8601 em UTC, campo vazio = null."
  },
  "servers": [{ "url": "/mentoria/v1" }],
  "tags": [
    { "name": "academy", "description": "Chamadas do Academy, via proxy, com token de serviço e X-Mentor-Id." },
    { "name": "mentorado", "description": "Chamadas da Página do Mentorado (Flix). Não passam pelo proxy do Academy." }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "obterMe", "tags": ["academy"],
        "responses": { "200": { "$ref": "#/components/responses/Me" }, "401": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" } }
      },
      "patch": {
        "operationId": "atualizarMe", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AtualizarMe" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Mentor" }, "400": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/tribos/{triboId}/alunos": {
      "get": {
        "operationId": "listarAlunos", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }, { "name": "busca", "in": "query", "schema": { "type": "string", "maxLength": 120 } }],
        "responses": { "200": { "$ref": "#/components/responses/PaginaAlunos" }, "403": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/tribos/{triboId}/alunos/{alunoId}": {
      "get": {
        "operationId": "obterAluno", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "name": "alunoId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "$ref": "#/components/responses/Aluno" }, "403": { "$ref": "#/components/responses/Erro" }, "404": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/tribos/{triboId}/canais": {
      "get": {
        "operationId": "listarCanais", "tags": ["academy"],
        "description": "Devolve só os canais da modalidade da tribo: B2C tem avisos, plantao e grupo_tribo; B2B só grupo_tribo.",
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }],
        "responses": { "200": { "$ref": "#/components/responses/Canais" }, "403": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/tribos/{triboId}/canais/grupo_tribo": {
      "put": {
        "operationId": "salvarGrupoTribo", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SalvarGrupoTribo" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Canal" }, "400": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/tribos/{triboId}/publicacoes": {
      "get": {
        "operationId": "listarPublicacoes", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }, { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/StatusPublicacao" } }, { "name": "tag", "in": "query", "schema": { "$ref": "#/components/schemas/TagPublicacao" } }],
        "responses": { "200": { "$ref": "#/components/responses/PaginaPublicacoes" }, "403": { "$ref": "#/components/responses/Erro" } }
      },
      "post": {
        "operationId": "criarPublicacao", "tags": ["academy"],
        "description": "Aluno que não é mais da tribo é descartado e nomeado em warnings. Se não sobrar destinatário: 422 sem_destinatarios. Fixar uma publicação desafixa a anterior, informada em desafixadaId. Ao publicar com anexo, a API confere o arquivo real: 422 anexo_invalido ou anexo_expirado.",
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NovaPublicacao" } } } },
        "responses": { "201": { "$ref": "#/components/responses/PublicacaoGravada" }, "400": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" }, "409": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/publicacoes/{id}": {
      "patch": {
        "operationId": "editarPublicacao", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EditarPublicacao" } } } },
        "responses": { "200": { "$ref": "#/components/responses/PublicacaoGravada" }, "400": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" }, "404": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      },
      "delete": {
        "operationId": "excluirPublicacao", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "204": { "description": "Excluída." }, "403": { "$ref": "#/components/responses/Erro" }, "404": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/uploads": {
      "post": {
        "operationId": "pedirUpload", "tags": ["academy"],
        "description": "Confere o tipo e o tamanho declarados e devolve a URL de envio. O limite de tamanho é imposto pelo armazenamento. Arquivo nunca publicado é apagado em até 48 horas.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PedidoUpload" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Upload" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/tribos/{triboId}/sessoes": {
      "get": {
        "operationId": "listarSessoes", "tags": ["academy"],
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "$ref": "#/components/parameters/Limit" }, { "$ref": "#/components/parameters/Cursor" }, { "name": "de", "in": "query", "schema": { "type": "string", "format": "date-time" } }, { "name": "ate", "in": "query", "schema": { "type": "string", "format": "date-time" } }, { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/StatusSessao" } }, { "name": "tipo", "in": "query", "schema": { "$ref": "#/components/schemas/TipoSessao" } }],
        "responses": { "200": { "$ref": "#/components/responses/PaginaSessoes" }, "403": { "$ref": "#/components/responses/Erro" } }
      },
      "post": {
        "operationId": "criarSessao", "tags": ["academy"],
        "description": "Cria encontro coletivo ou individual direto. A sala do Meet é pedida em seguida (meet.estado = pendente). Individual com aluno fora da tribo: 422 aluno_fora_da_tribo. Sobreposição com outra sessão do mentor, em qualquer tribo: 409 conflito_horario.",
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NovaSessao" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Sessao" }, "400": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" }, "409": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/tribos/{triboId}/horarios": {
      "post": {
        "operationId": "criarHorarios", "tags": ["academy"],
        "description": "Divide a janela [inicio, fim) em horários de duracaoMin e cria uma sessão disponivel para cada um, sem sala do Meet. Sobra que não cabe é descartada. Fora do horizonte de 30 dias: 422 fora_do_horizonte. No passado: 400 validacao. Sobreposição com outra sessão do mentor, em qualquer tribo: 409 conflito_horario, e nada é criado.",
        "parameters": [{ "$ref": "#/components/parameters/TriboId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NovaJanela" } } } },
        "responses": { "201": { "$ref": "#/components/responses/ListaSessoes" }, "400": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" }, "409": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/sessoes/{id}": {
      "patch": {
        "operationId": "editarSessao", "tags": ["academy"],
        "description": "Coletiva: data, hora, tema e descrição editáveis até o início da janela ao vivo (10 minutos antes do início); mudar a data gera aviso automático no mural (avisoPublicacaoId). Individual reservada não se edita: 422 sessao_nao_editavel. meetUrl só é aceito quando meet.estado = falhou.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EditarSessao" } } } },
        "responses": { "200": { "$ref": "#/components/responses/SessaoAlterada" }, "400": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" }, "404": { "$ref": "#/components/responses/Erro" }, "409": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      },
      "delete": {
        "operationId": "excluirHorario", "tags": ["academy"],
        "description": "Só exclui horário livre (tipo disponivel). Se já foi reservado: 409 horario_reservado, com o nome do aluno em message. Outros tipos: 422 use_cancelar.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "204": { "description": "Horário excluído." }, "403": { "$ref": "#/components/responses/Erro" }, "404": { "$ref": "#/components/responses/Erro" }, "409": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/sessoes/{id}/cancelar": {
      "post": {
        "operationId": "cancelarSessao", "tags": ["academy"],
        "description": "Cancela encontro coletivo ou individual, a qualquer momento antes do fim. Gera aviso automático: no mural da tribo (coletiva) ou em Pra você (individual). O horário cancelado não volta a ficar livre.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CancelarSessao" } } } },
        "responses": { "200": { "$ref": "#/components/responses/SessaoAlterada" }, "403": { "$ref": "#/components/responses/Erro" }, "404": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/sessoes/{id}/gravacao": {
      "post": {
        "operationId": "vincularGravacao", "tags": ["academy"],
        "description": "Caminho manual: o mentor cola o link. Só coletivas realizadas; individual: 422 gravacao_nao_permitida.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VincularGravacao" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Sessao" }, "400": { "$ref": "#/components/responses/Erro" }, "403": { "$ref": "#/components/responses/Erro" }, "404": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/sessoes/{id}/reservar": {
      "post": {
        "operationId": "reservarHorario", "tags": ["mentorado"],
        "description": "Aluno logado. Grava só se o horário ainda estiver livre: senão 409 horario_ocupado. Já tem reserva futura: 422 limite_reservas. Menos de 2 horas para o início: 422 fora_do_prazo. A resposta sai com meet.estado = pendente; a sala é criada em fila.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "200": { "$ref": "#/components/responses/Sessao" }, "404": { "$ref": "#/components/responses/Erro" }, "409": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    },
    "/sessoes/{id}/reserva": {
      "delete": {
        "operationId": "cancelarReserva", "tags": ["mentorado"],
        "description": "Aluno cancela a própria reserva até 2 horas antes; o horário volta a ficar disponivel, sem sala. Depois disso: 422 fora_do_prazo.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "204": { "description": "Reserva cancelada." }, "404": { "$ref": "#/components/responses/Erro" }, "422": { "$ref": "#/components/responses/Erro" } }
      }
    }
  },
  "components": {
    "parameters": {
      "TriboId": { "name": "triboId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "string" } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "description": "Gerada pelo cliente, uma por intenção do usuário, reusada em novas tentativas. A API guarda por 24 horas e devolve a resposta original. Mesma chave com corpo diferente: 409 chave_reutilizada.", "schema": { "type": "string", "minLength": 16, "maxLength": 64 } }
    },
    "headers": {
      "XRequestId": { "description": "ID da requisição. O Academy envia o seu; a API repassa e devolve.", "schema": { "type": "string" } }
    },
    "responses": {
      "Erro": { "description": "Erro no formato do contrato.", "headers": { "X-Request-Id": { "$ref": "#/components/headers/XRequestId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Erro" } } } },
      "Me": { "description": "Mentor e tribos.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Me" } } } },
      "Mentor": { "description": "Mentor.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Mentor" } } } },
      "Aluno": { "description": "Aluno.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Aluno" } } } },
      "PaginaAlunos": { "description": "Página de alunos.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaAlunos" } } } },
      "Canal": { "description": "Canal.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Canal" } } } },
      "Canais": { "description": "Canais da tribo.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListaCanais" } } } },
      "PaginaPublicacoes": { "description": "Página de publicações.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaPublicacoes" } } } },
      "PublicacaoGravada": { "description": "Publicação, com avisos.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicacaoGravada" } } } },
      "Upload": { "description": "URL de envio.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Upload" } } } },
      "Sessao": { "description": "Sessão.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Sessao" } } } },
      "SessaoAlterada": { "description": "Sessão, com o aviso automático gerado.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessaoAlterada" } } } },
      "ListaSessoes": { "description": "Sessões criadas.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ListaSessoes" } } } },
      "PaginaSessoes": { "description": "Página de sessões.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaSessoes" } } } }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid" },
      "DataHora": { "type": "string", "format": "date-time", "description": "ISO 8601 em UTC, terminando em Z." },
      "DataHoraOuNull": { "type": ["string", "null"], "format": "date-time" },
      "TextoOuNull": { "type": ["string", "null"] },
      "UrlHttps": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2000 },
      "CodigoErro": {
        "type": "string",
        "enum": ["validacao", "token_invalido", "sem_acesso_tribo", "canal_nao_editavel", "nao_encontrado", "chave_reutilizada", "conflito_horario", "horario_ocupado", "horario_reservado", "aluno_fora_da_tribo", "sem_destinatarios", "limite_destinatarios", "anexo_invalido", "anexo_expirado", "fora_do_horizonte", "fora_do_prazo", "limite_reservas", "sessao_nao_editavel", "use_cancelar", "gravacao_nao_permitida", "limite_requisicoes"]
      },
      "Erro": {
        "type": "object", "required": ["error"], "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object", "required": ["code", "message"], "additionalProperties": false,
            "properties": { "code": { "$ref": "#/components/schemas/CodigoErro" }, "message": { "type": "string" }, "field": { "$ref": "#/components/schemas/TextoOuNull" }, "requestId": { "$ref": "#/components/schemas/TextoOuNull" } }
          }
        }
      },
      "Modalidade": { "type": "string", "enum": ["b2c", "b2b"] },
      "Mentor": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "nome", "fotoUrl", "bio", "mote", "googleEmail", "modalidade", "ativo"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "nome": { "type": "string", "minLength": 1, "maxLength": 120 },
          "fotoUrl": { "$ref": "#/components/schemas/TextoOuNull" },
          "bio": { "type": ["string", "null"], "maxLength": 500 },
          "mote": { "type": ["string", "null"], "maxLength": 120, "description": "Exibido sob o nome na Página do Mentorado." },
          "googleEmail": { "type": ["string", "null"], "maxLength": 254, "description": "Conta Google que o mentor usa no Meet. Com ela, o mentor entra como coorganizador das salas." },
          "modalidade": { "$ref": "#/components/schemas/Modalidade" },
          "ativo": { "type": "boolean" }
        }
      },
      "AtualizarMe": {
        "type": "object", "additionalProperties": false, "minProperties": 1,
        "properties": { "fotoUrl": { "$ref": "#/components/schemas/TextoOuNull" }, "bio": { "type": ["string", "null"], "maxLength": 500 }, "mote": { "type": ["string", "null"], "maxLength": 120 }, "googleEmail": { "type": ["string", "null"], "maxLength": 254 } }
      },
      "TriboMe": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "slug", "nome", "modalidade", "papel", "lema", "iconeUrl", "cores", "iesId", "iesNome", "campus", "encontrosPorMes", "totalAlunos", "mentoriaAtiva"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "slug": { "type": "string" },
          "nome": { "type": "string" },
          "modalidade": { "$ref": "#/components/schemas/Modalidade" },
          "papel": { "type": "string", "enum": ["titular", "apoio"] },
          "lema": { "$ref": "#/components/schemas/TextoOuNull" },
          "iconeUrl": { "$ref": "#/components/schemas/TextoOuNull" },
          "cores": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["sig", "shadow", "glow"], "properties": { "sig": { "type": "string" }, "shadow": { "type": "string" }, "glow": { "type": "string" } } }] },
          "iesId": { "type": ["string", "null"], "format": "uuid" },
          "iesNome": { "$ref": "#/components/schemas/TextoOuNull" },
          "campus": { "$ref": "#/components/schemas/TextoOuNull" },
          "encontrosPorMes": { "type": ["integer", "null"], "minimum": 0 },
          "totalAlunos": { "type": "integer", "minimum": 0 },
          "mentoriaAtiva": { "type": "boolean", "description": "Feature toggle por tribo." }
        }
      },
      "Me": {
        "type": "object", "additionalProperties": false, "required": ["mentor", "tribos"],
        "properties": { "mentor": { "$ref": "#/components/schemas/Mentor" }, "tribos": { "type": "array", "items": { "$ref": "#/components/schemas/TriboMe" } } }
      },
      "Aluno": {
        "type": "object", "additionalProperties": false,
        "required": ["alunoId", "nome", "email", "whatsapp", "produto", "acessoAte", "semestre", "campus", "triboId", "entrouNaTriboEm", "origemAlocacao", "ultimaAtividadeEm", "meta"],
        "properties": {
          "alunoId": { "$ref": "#/components/schemas/Uuid" },
          "nome": { "type": "string" },
          "email": { "type": "string" },
          "whatsapp": { "$ref": "#/components/schemas/TextoOuNull" },
          "produto": { "type": "string", "enum": ["pro", "padrao"] },
          "acessoAte": { "type": ["string", "null"], "format": "date" },
          "semestre": { "type": ["integer", "null"], "minimum": 1, "maximum": 12 },
          "campus": { "$ref": "#/components/schemas/TextoOuNull" },
          "triboId": { "$ref": "#/components/schemas/Uuid" },
          "entrouNaTriboEm": { "$ref": "#/components/schemas/DataHora" },
          "origemAlocacao": { "type": "string", "enum": ["onboarding", "cx", "sgi_lote", "retroativo"] },
          "ultimaAtividadeEm": { "$ref": "#/components/schemas/DataHoraOuNull" },
          "meta": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["especialidade", "instituicao", "cortePct"], "properties": { "especialidade": { "type": "string" }, "instituicao": { "type": "string" }, "cortePct": { "type": "number", "minimum": 0, "maximum": 100 } } }] }
        }
      },
      "PaginaAlunos": {
        "type": "object", "additionalProperties": false, "required": ["data", "nextCursor"],
        "properties": { "data": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Aluno" } }, "nextCursor": { "$ref": "#/components/schemas/TextoOuNull" } }
      },
      "TipoCanal": { "type": "string", "enum": ["avisos", "plantao", "grupo_tribo"] },
      "Canal": {
        "type": "object", "additionalProperties": false, "required": ["triboId", "tipo", "nome", "url", "editavel"],
        "properties": { "triboId": { "$ref": "#/components/schemas/Uuid" }, "tipo": { "$ref": "#/components/schemas/TipoCanal" }, "nome": { "type": "string" }, "url": { "$ref": "#/components/schemas/TextoOuNull" }, "editavel": { "type": "boolean" } }
      },
      "ListaCanais": { "type": "array", "maxItems": 3, "items": { "$ref": "#/components/schemas/Canal" } },
      "SalvarGrupoTribo": {
        "type": "object", "additionalProperties": false, "required": ["url"],
        "properties": { "url": { "type": "string", "pattern": "^https://chat\\.whatsapp\\.com/[A-Za-z0-9_-]+$", "maxLength": 200 } }
      },
      "TagPublicacao": { "type": "string", "enum": ["desempenho", "novidade", "aviso", "fique_por_dentro"] },
      "StatusPublicacao": { "type": "string", "enum": ["rascunho", "publicada"] },
      "LinkPublicacao": {
        "type": "object", "additionalProperties": false, "required": ["url", "titulo"],
        "properties": { "url": { "$ref": "#/components/schemas/UrlHttps" }, "titulo": { "type": "string", "minLength": 1, "maxLength": 120 } }
      },
      "Anexo": {
        "type": "object", "additionalProperties": false, "required": ["arquivoId", "nome", "mime", "bytes"],
        "properties": { "arquivoId": { "$ref": "#/components/schemas/Uuid" }, "nome": { "type": "string", "minLength": 1, "maxLength": 200 }, "mime": { "$ref": "#/components/schemas/MimeAnexo" }, "bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 } }
      },
      "MimeAnexo": { "type": "string", "enum": ["application/pdf", "image/png", "image/jpeg", "image/webp"] },
      "Destino": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["tipo"], "properties": { "tipo": { "const": "tribo" } } },
          { "type": "object", "additionalProperties": false, "required": ["tipo", "alunoIds"], "properties": { "tipo": { "const": "alunos" }, "alunoIds": { "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": { "$ref": "#/components/schemas/Uuid" } } } }
        ]
      },
      "NovaPublicacao": {
        "type": "object", "additionalProperties": false,
        "required": ["tag", "titulo", "mensagem", "destino", "status"],
        "properties": {
          "tag": { "$ref": "#/components/schemas/TagPublicacao" },
          "titulo": { "type": "string", "minLength": 1, "maxLength": 120 },
          "mensagem": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "link": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/LinkPublicacao" }] },
          "anexoId": { "type": ["string", "null"], "format": "uuid", "description": "arquivoId devolvido por POST /uploads." },
          "destino": { "$ref": "#/components/schemas/Destino" },
          "grupoRotulo": { "type": ["string", "null"], "maxLength": 120, "description": "Só para o histórico: o grupo usado para pré-selecionar. A API não interpreta." },
          "grupoTotal": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "$ref": "#/components/schemas/StatusPublicacao" },
          "fixada": { "type": "boolean" }
        }
      },
      "EditarPublicacao": {
        "type": "object", "additionalProperties": false, "minProperties": 1,
        "properties": {
          "tag": { "$ref": "#/components/schemas/TagPublicacao" },
          "titulo": { "type": "string", "minLength": 1, "maxLength": 120 },
          "mensagem": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "link": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/LinkPublicacao" }] },
          "anexoId": { "type": ["string", "null"], "format": "uuid" },
          "destino": { "$ref": "#/components/schemas/Destino" },
          "grupoRotulo": { "type": ["string", "null"], "maxLength": 120 },
          "grupoTotal": { "type": ["integer", "null"], "minimum": 0 },
          "status": { "$ref": "#/components/schemas/StatusPublicacao" },
          "fixada": { "type": "boolean" }
        }
      },
      "Publicacao": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "triboId", "autorMentorId", "tag", "titulo", "mensagem", "link", "anexo", "destino", "grupoRotulo", "grupoTotal", "status", "fixada", "publicadaEm", "editadaEm", "origem", "destinatarios", "lidas", "createdAt", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "triboId": { "$ref": "#/components/schemas/Uuid" },
          "autorMentorId": { "$ref": "#/components/schemas/Uuid" },
          "tag": { "$ref": "#/components/schemas/TagPublicacao" },
          "titulo": { "type": "string" },
          "mensagem": { "type": "string" },
          "link": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/LinkPublicacao" }] },
          "anexo": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/Anexo" }] },
          "destino": { "$ref": "#/components/schemas/Destino" },
          "grupoRotulo": { "$ref": "#/components/schemas/TextoOuNull" },
          "grupoTotal": { "type": ["integer", "null"] },
          "status": { "$ref": "#/components/schemas/StatusPublicacao" },
          "fixada": { "type": "boolean" },
          "publicadaEm": { "$ref": "#/components/schemas/DataHoraOuNull" },
          "editadaEm": { "$ref": "#/components/schemas/DataHoraOuNull" },
          "origem": { "type": "string", "enum": ["manual", "aviso_sessao"] },
          "destinatarios": { "type": ["integer", "null"], "minimum": 0, "description": "Quantos receberam. null em publicação para a tribo toda." },
          "lidas": { "type": ["integer", "null"], "minimum": 0, "description": "Quantos leram. null em publicação para a tribo toda." },
          "createdAt": { "$ref": "#/components/schemas/DataHora" },
          "updatedAt": { "$ref": "#/components/schemas/DataHora" }
        }
      },
      "AvisoPublicacao": {
        "type": "object", "additionalProperties": false, "required": ["code", "alunoIds", "nomes"],
        "properties": { "code": { "const": "aluno_fora_da_tribo" }, "alunoIds": { "type": "array", "items": { "$ref": "#/components/schemas/Uuid" } }, "nomes": { "type": "array", "items": { "type": "string" } } }
      },
      "PublicacaoGravada": {
        "type": "object", "additionalProperties": false, "required": ["publicacao", "warnings", "desafixadaId"],
        "properties": {
          "publicacao": { "$ref": "#/components/schemas/Publicacao" },
          "warnings": { "type": "array", "items": { "$ref": "#/components/schemas/AvisoPublicacao" } },
          "desafixadaId": { "type": ["string", "null"], "format": "uuid" }
        }
      },
      "PaginaPublicacoes": {
        "type": "object", "additionalProperties": false, "required": ["data", "nextCursor"],
        "properties": { "data": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Publicacao" } }, "nextCursor": { "$ref": "#/components/schemas/TextoOuNull" } }
      },
      "PedidoUpload": {
        "type": "object", "additionalProperties": false, "required": ["nome", "mime", "bytes"],
        "properties": { "nome": { "type": "string", "minLength": 1, "maxLength": 200 }, "mime": { "$ref": "#/components/schemas/MimeAnexo" }, "bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 } }
      },
      "Upload": {
        "type": "object", "additionalProperties": false, "required": ["arquivoId", "uploadUrl", "metodo", "campos", "expiraEm"],
        "properties": {
          "arquivoId": { "$ref": "#/components/schemas/Uuid" },
          "uploadUrl": { "$ref": "#/components/schemas/UrlHttps" },
          "metodo": { "type": "string", "enum": ["PUT", "POST"], "description": "POST = formulário com política (campos); PUT = corpo é o arquivo." },
          "campos": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Campos do formulário quando metodo = POST; vazio em PUT." },
          "expiraEm": { "$ref": "#/components/schemas/DataHora" }
        }
      },
      "TipoSessao": { "type": "string", "enum": ["encontro_tribo", "pos_simulado", "oficina", "individual", "disponivel"] },
      "StatusSessao": { "type": "string", "enum": ["agendada", "realizada", "cancelada"] },
      "Meet": {
        "type": "object", "additionalProperties": false, "required": ["salaId", "url", "estado"],
        "properties": {
          "salaId": { "type": ["string", "null"], "description": "Nome estável da sala no Google Meet (spaces/...). Uma sala por sessão." },
          "url": { "type": ["string", "null"], "pattern": "^https://[^\\s]+$" },
          "estado": { "type": "string", "enum": ["sem_sala", "pendente", "pronto", "falhou"], "description": "sem_sala: horário livre. pendente: na fila. pronto: url preenchida. falhou: o mentor cola o link." }
        }
      },
      "Gravacao": {
        "type": "object", "additionalProperties": false, "required": ["estado", "url", "duracaoSeg", "disponivelEm"],
        "properties": {
          "estado": { "type": "string", "enum": ["nao_se_aplica", "aguardando", "pronta", "pendente", "manual"], "description": "nao_se_aplica: individual ou ainda não realizada. aguardando: realizada há menos de 24 horas. pendente: passou de 24 horas sem ligação. pronta: ligada pela rotina. manual: ligada pelo mentor." },
          "url": { "type": ["string", "null"], "pattern": "^https://[^\\s]+$" },
          "duracaoSeg": { "type": ["integer", "null"], "minimum": 0 },
          "disponivelEm": { "$ref": "#/components/schemas/DataHoraOuNull" }
        }
      },
      "ItemPauta": {
        "type": "object", "additionalProperties": false, "required": ["texto", "origem", "referenciaId", "ordem"],
        "properties": { "texto": { "type": "string", "minLength": 1, "maxLength": 300 }, "origem": { "type": "string", "enum": ["tema_critico", "mais_erradas", "livre"] }, "referenciaId": { "$ref": "#/components/schemas/TextoOuNull" }, "ordem": { "type": "integer", "minimum": 0 } }
      },
      "Sessao": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "triboId", "mentorId", "tipo", "inicio", "duracaoMin", "tema", "descricao", "alunoId", "alunoNome", "status", "canceladaMotivo", "meet", "gravacao", "pauta", "createdAt", "updatedAt"],
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "triboId": { "$ref": "#/components/schemas/Uuid" },
          "mentorId": { "$ref": "#/components/schemas/Uuid" },
          "tipo": { "$ref": "#/components/schemas/TipoSessao" },
          "inicio": { "$ref": "#/components/schemas/DataHora" },
          "duracaoMin": { "type": "integer", "minimum": 5, "maximum": 480 },
          "tema": { "type": ["string", "null"], "maxLength": 160 },
          "descricao": { "type": ["string", "null"], "maxLength": 1000 },
          "alunoId": { "type": ["string", "null"], "format": "uuid" },
          "alunoNome": { "$ref": "#/components/schemas/TextoOuNull" },
          "status": { "$ref": "#/components/schemas/StatusSessao" },
          "canceladaMotivo": { "$ref": "#/components/schemas/TextoOuNull" },
          "meet": { "$ref": "#/components/schemas/Meet" },
          "gravacao": { "$ref": "#/components/schemas/Gravacao" },
          "pauta": { "type": "array", "items": { "$ref": "#/components/schemas/ItemPauta" } },
          "createdAt": { "$ref": "#/components/schemas/DataHora" },
          "updatedAt": { "$ref": "#/components/schemas/DataHora" }
        }
      },
      "NovaSessao": {
        "type": "object", "additionalProperties": false, "required": ["tipo", "inicio"],
        "properties": {
          "tipo": { "type": "string", "enum": ["encontro_tribo", "pos_simulado", "oficina", "individual"] },
          "inicio": { "$ref": "#/components/schemas/DataHora" },
          "duracaoMin": { "type": "integer", "minimum": 5, "maximum": 480 },
          "tema": { "type": ["string", "null"], "maxLength": 160 },
          "descricao": { "type": ["string", "null"], "maxLength": 1000 },
          "alunoId": { "type": ["string", "null"], "format": "uuid" },
          "pauta": { "type": "array", "items": { "$ref": "#/components/schemas/ItemPauta" } }
        }
      },
      "NovaJanela": {
        "type": "object", "additionalProperties": false, "required": ["inicio", "fim", "duracaoMin"],
        "properties": { "inicio": { "$ref": "#/components/schemas/DataHora" }, "fim": { "$ref": "#/components/schemas/DataHora" }, "duracaoMin": { "type": "integer", "enum": [30, 45, 60] } }
      },
      "EditarSessao": {
        "type": "object", "additionalProperties": false, "minProperties": 1,
        "properties": {
          "inicio": { "$ref": "#/components/schemas/DataHora" },
          "duracaoMin": { "type": "integer", "minimum": 5, "maximum": 480 },
          "tema": { "type": ["string", "null"], "maxLength": 160 },
          "descricao": { "type": ["string", "null"], "maxLength": 1000 },
          "meetUrl": { "$ref": "#/components/schemas/UrlHttps" },
          "status": { "type": "string", "enum": ["realizada"] },
          "pauta": { "type": "array", "items": { "$ref": "#/components/schemas/ItemPauta" } }
        }
      },
      "CancelarSessao": {
        "type": "object", "additionalProperties": false,
        "properties": { "motivo": { "type": ["string", "null"], "maxLength": 300 } }
      },
      "VincularGravacao": {
        "type": "object", "additionalProperties": false, "required": ["url"],
        "properties": { "url": { "$ref": "#/components/schemas/UrlHttps" }, "duracaoSeg": { "type": ["integer", "null"], "minimum": 0 } }
      },
      "SessaoAlterada": {
        "type": "object", "additionalProperties": false, "required": ["sessao", "avisoPublicacaoId"],
        "properties": { "sessao": { "$ref": "#/components/schemas/Sessao" }, "avisoPublicacaoId": { "type": ["string", "null"], "format": "uuid", "description": "Publicação automática gerada por cancelamento ou mudança de data; null se não houve." } }
      },
      "ListaSessoes": {
        "type": "object", "additionalProperties": false, "required": ["data"],
        "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Sessao" } } }
      },
      "PaginaSessoes": {
        "type": "object", "additionalProperties": false, "required": ["data", "nextCursor"],
        "properties": { "data": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Sessao" } }, "nextCursor": { "$ref": "#/components/schemas/TextoOuNull" } }
      }
    }
  }
}
