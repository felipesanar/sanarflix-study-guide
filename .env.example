# =============================================================================
# SanarFlix Guia de Estudos — exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commitar .env / .env.local (já no .gitignore via "*.env").
# =============================================================================

# ----- Supabase (obrigatório) -----
# URL do projeto Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Chave pública do projeto. A Lovable normalmente injeta VITE_SUPABASE_PUBLISHABLE_KEY.
# Mantemos VITE_SUPABASE_ANON_KEY por compatibilidade local/legada.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_ANON_KEY=your-anon-key

# ----- Base URLs (opcionais; derivam de VITE_SUPABASE_URL se vazio) -----
# Override do proxy do guia de estudos (apenas se diferente do default)
VITE_STUDY_GUIDE_API_BASE_URL=
# Override da base de Edge Functions (apenas se diferente de ${VITE_SUPABASE_URL}/functions/v1)
VITE_EDGE_FUNCTIONS_BASE_URL=

# ----- Ambiente -----
# development | staging | production
VITE_APP_ENV=development

# ----- Feature flags (Fase 1+ do plano de remediação) -----
# Habilita correção da race condition em ModoProva.finalizarSimulado
VITE_FF_PROVA_RACE_FIX=false
# Habilita arquitetura server-first v2 em useCalendarSync
VITE_FF_CALENDAR_V2=false
